{
    "name": "realtime-notes",
    "version": "1.0.0",
    "description": "",
    "main": "dist/server.js",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch --clear-screen=false src/server.ts",
        "dev:prod": "NODE_ENV=production tsx watch --clear-screen=false src/server.ts",
        "start": "node dist/server.js",
        "build": "tsc",
        "postinstall": "prisma generate",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "echo \"Error: no test specified\" && exit 1",
        "db:pull": "dotenv -e .env.development -- npx prisma db pull",
        "db:push": "dotenv -e .env.development -- npx prisma db push",
        "db:generate": "dotenv -e .env.development -- npx prisma generate",
        "db:migrate": "dotenv -e .env.development -- npx prisma migrate dev",
        "db:studio": "dotenv -e .env.development -- npx prisma studio"
    },
    "keywords": [],
    "author": "siddhant deval",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.16.3",
        "socket.io": "^4.8.3",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@tsconfig/node22": "^22.0.2",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.0.3",
        "@types/pg": "^8.16.0",
        "@types/socket.io": "^3.0.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.37.0",
        "prettier": "^3.6.2",
        "prisma": "^7.2.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.1"
    }
}
